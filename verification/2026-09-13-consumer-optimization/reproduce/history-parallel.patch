+package state
+
+import (
+	"context"
+	"os"
+	"testing"
+	"time"
+
+	commonv1 "example.com/meshops-course/gen/common/v1"
+	"example.com/meshops-course/internal/platform"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/timestamppb"
+)
+
+// 真实 MySQL 中阻塞实体 A 的去重键插入，实体 B 仍须完成；全局 I/O 锁会使此测试失败。
+func TestHistoryBlockedEntityDoesNotBlockAnotherEntity(t *testing.T) {
+	if os.Getenv("MESHOPS_TEST_MYSQL_DSN") == "" {
+		t.Skip("requires real MySQL")
+	}
+	db, err := platform.OpenDB("MESHOPS_TEST_MYSQL_DSN")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	r, event := ingestFixture(t)
+	tenant := "history_parallel_" + newID()
+	source := r.Sources["t:s"]
+	source.TenantID = tenant
+	r.Sources = map[string]platform.Source{platform.Key(tenant, "s"): source}
+	binding := r.Bindings["t:p"]
+	binding.TenantID = tenant
+	r.Bindings = map[string]platform.Binding{}
+	for _, id := range []string{"p", "q"} {
+		b := binding
+		b.EntityID = id
+		r.Bindings[platform.Key(tenant, id)] = b
+	}
+	event.TenantId = tenant
+	event.EventId = newID()
+	event.OccurredAt = timestamppb.New(time.Now().UTC())
+	event.ExpiresAt = timestamppb.New(event.OccurredAt.AsTime().Add(30 * time.Second))
+	other := proto.Clone(event).(*commonv1.EntityStateEvent)
+	other.EntityId = "q"
+	other.EventId = newID()
+	e := &Entity{db: db, registry: r, cfg: platform.Settings{HistoryPeriod: "1s", HistoryBudget: 200}, historyLast: map[string]*commonv1.EntityStateEvent{}, historyAllowed: map[string]bool{platform.Key(tenant, "p"): true, platform.Key(tenant, "q"): true}}
+	defer func() {
+		c, stop := context.WithTimeout(context.Background(), 5*time.Second)
+		defer stop()
+		for _, table := range []string{"history_sample_keys", "entity_history_samples"} {
+			if _, err := db.ExecContext(c, "DELETE FROM "+table+" WHERE tenant_id=?", tenant); err != nil {
+				t.Error(err)
+			}
+		}
+	}()
+	block, err := db.BeginTx(ctx, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer block.Rollback()
+	if _, err = block.ExecContext(ctx, `INSERT INTO history_sample_keys(tenant_id,source_id,source_generation,event_id,sampled_at,sample_id) VALUES(?,?,?,?,?,0)`, tenant, event.SourceId, event.SourceGeneration, event.EventId, time.Now().UTC()); err != nil {
+		t.Fatal(err)
+	}
+	if err := Validate(event, r); err != nil {
+		t.Fatal("invalid test fixture", err)
+	}
+	raw, err := proto.Marshal(event)
+	if err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() { done <- e.Sample(ctx, raw) }()
+	// 以数据库锁等待证据同步，不用固定 sleep 猜测 goroutine 是否进入事务。
+	for {
+		var waits int
+		err = db.QueryRowContext(ctx, `SELECT COUNT(*) FROM performance_schema.data_lock_waits w JOIN performance_schema.data_locks l ON w.REQUESTING_ENGINE_LOCK_ID=l.ENGINE_LOCK_ID WHERE l.OBJECT_SCHEMA=DATABASE() AND l.OBJECT_NAME='history_sample_keys'`).Scan(&waits)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if waits > 0 {
+			break
+		}
+		select {
+		case err := <-done:
+			t.Fatalf("blocked sample exited early: %v", err)
+		case <-ctx.Done():
+			t.Fatal("sample did not reach blocked insert")
+		case <-time.After(10 * time.Millisecond):
+		}
+	}
+	otherRaw, err := proto.Marshal(other)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// A 的第二个候选必须等待第一笔事务，再依据新样本判断无需重复采样。
+	second := proto.Clone(event).(*commonv1.EntityStateEvent)
+	second.EventId = newID()
+	second.EntityVersion++
+	secondRaw, err := proto.Marshal(second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	secondDone := make(chan error, 1)
+	go func() { secondDone <- e.Sample(ctx, secondRaw) }()
+	otherCtx, stop := context.WithTimeout(ctx, 2*time.Second)
+	err = e.Sample(otherCtx, otherRaw)
+	stop()
+	if err != nil {
+		t.Errorf("unrelated entity blocked: %v", err)
+	}
+	select {
+	case err := <-secondDone:
+		t.Errorf("same-entity candidate crossed blocked transaction: %v", err)
+		secondDone = nil
+	default:
+	}
+	if err = block.Rollback(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err = <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-ctx.Done():
+		t.Fatal("blocked entity did not recover")
+	}
+	if secondDone != nil {
+		select {
+		case err := <-secondDone:
+			if err != nil {
+				t.Fatal(err)
+			}
+		case <-ctx.Done():
+			t.Fatal("second candidate did not finish")
+		}
+	}
+	// 重复调用仍只能有两份样本，独立实体并行不能破坏幂等。
+	if err = e.Sample(ctx, raw); err != nil {
+		t.Fatal(err)
+	}
+	var rows int
+	if err = db.QueryRowContext(ctx, "SELECT COUNT(*) FROM entity_history_samples WHERE tenant_id=?", tenant).Scan(&rows); err != nil || rows != 2 {
+		t.Fatalf("stored rows=%d err=%v", rows, err)
+	}
+}
+
+func TestHistorySampleRefundsFailedAndDuplicateWrites(t *testing.T) {
+	if os.Getenv("MESHOPS_TEST_MYSQL_DSN") == "" {
+		t.Skip("requires real MySQL")
+	}
+	db, err := platform.OpenDB("MESHOPS_TEST_MYSQL_DSN")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	r, event := ingestFixture(t)
+	tenant := "history_refund_" + newID()
+	source := r.Sources["t:s"]
+	source.TenantID = tenant
+	binding := r.Bindings["t:p"]
+	binding.TenantID = tenant
+	r.Sources = map[string]platform.Source{platform.Key(tenant, "s"): source}
+	r.Bindings = map[string]platform.Binding{platform.Key(tenant, "p"): binding}
+	event.TenantId = tenant
+	event.EventId = newID()
+	event.OccurredAt = timestamppb.New(time.Now().UTC())
+	event.ExpiresAt = timestamppb.New(event.OccurredAt.AsTime().Add(30 * time.Second))
+	key := platform.Key(tenant, "p")
+	e := &Entity{db: db, registry: r, cfg: platform.Settings{HistoryPeriod: "1s", HistoryBudget: 1}, historyAllowed: map[string]bool{key: true}, historyLast: map[string]*commonv1.EntityStateEvent{key: nil}}
+	if err := Validate(event, r); err != nil {
+		t.Fatal("invalid test fixture", err)
+	}
+	raw, err := proto.Marshal(event)
+	if err != nil {
+		t.Fatal(err)
+	}
+	failed, stop := context.WithCancel(ctx)
+	stop()
+	if err = e.Sample(failed, raw); err == nil {
+		t.Fatal("cancelled write unexpectedly succeeded")
+	}
+	if e.budgetTotal != 0 || e.budgetPeriodic != 0 {
+		t.Fatal("failed transaction leaked reservation")
+	}
+	// 预置已持久化去重键，模拟重放落到插入冲突分支；不产生孤立样本。
+	if _, err = db.ExecContext(ctx, `INSERT INTO history_sample_keys(tenant_id,source_id,source_generation,event_id,sampled_at,sample_id) VALUES(?,?,?,?,?,0)`, tenant, event.SourceId, event.SourceGeneration, event.EventId, time.Now().UTC()); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		c, stop := context.WithTimeout(context.Background(), 5*time.Second)
+		defer stop()
+		if _, err := db.ExecContext(c, "DELETE FROM history_sample_keys WHERE tenant_id=?", tenant); err != nil {
+			t.Error(err)
+		}
+	}()
+	if err = e.Sample(ctx, raw); err != nil {
+		t.Fatal(err)
+	}
+	if e.budgetTotal != 0 || e.budgetPeriodic != 0 {
+		t.Fatal("duplicate write leaked reservation")
+	}
+	var rows int
+	if err = db.QueryRowContext(ctx, "SELECT COUNT(*) FROM entity_history_samples WHERE tenant_id=?", tenant).Scan(&rows); err != nil || rows != 0 {
+		t.Fatalf("duplicate created sample rows=%d err=%v", rows, err)
+	}
+}
