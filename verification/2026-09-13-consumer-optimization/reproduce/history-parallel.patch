+package state
+
+import "sync"
+
+// historyLock 仅对 historyAllowed 中的有限实体创建锁，容量不随事件历史增长。
+// historyMu 保护锁表、缓存和预算；拿到实体锁后，数据库调用不持有 historyMu。
+func (e *Entity) historyLock(key string) *sync.Mutex {
+	e.historyMu.Lock()
+	defer e.historyMu.Unlock()
+	if e.historyLocks == nil {
+		e.historyLocks = make(map[string]*sync.Mutex)
+	}
+	l := e.historyLocks[key]
+	if l == nil {
+		l = &sync.Mutex{}
+		e.historyLocks[key] = l
+	}
+	return l
+}
+
+// 预算约束本实例每秒准入的采样候选（含正在写库的候选），不是集群全局限额。
+func (e *Entity) reserveHistoryBudget(second int64, periodic bool) bool {
+	e.historyMu.Lock()
+	defer e.historyMu.Unlock()
+	// 并发调用可能带着上一秒取得的时间稍晚进入短锁；不能倒退窗口重新发放额度。
+	if second < e.budgetSecond {
+		return false
+	}
+	if e.budgetSecond != second {
+		e.budgetSecond = second
+		e.budgetTotal = 0
+		e.budgetPeriodic = 0
+	}
+	if e.budgetTotal >= e.cfg.HistoryBudget || periodic && e.budgetPeriodic >= 100 {
+		return false
+	}
+	e.budgetTotal++
+	if periodic {
+		e.budgetPeriodic++
+	}
+	return true
+}
+
+func (e *Entity) refundHistoryBudget(second int64, periodic bool) {
+	e.historyMu.Lock()
+	defer e.historyMu.Unlock()
+	// 慢事务可能跨秒结束，不能扣减新一秒其他事务的预留。
+	if e.budgetSecond != second {
+		return
+	}
+	e.budgetTotal--
+	if periodic {
+		e.budgetPeriodic--
+	}
+}
