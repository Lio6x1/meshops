+package state
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+)
+
+// 并行候选先预留预算，防止不同实体同时写库时突破每秒上限。
+func TestHistoryBudgetConcurrentAdmissionAndRefund(t *testing.T) {
+	e := &Entity{}
+	e.cfg.HistoryBudget = 17
+	var allowed atomic.Int64
+	var wg sync.WaitGroup
+	for i := 0; i < 200; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if e.reserveHistoryBudget(100, false) {
+				allowed.Add(1)
+			}
+		}()
+	}
+	wg.Wait()
+	if allowed.Load() != 17 {
+		t.Fatalf("admitted %d, want 17", allowed.Load())
+	}
+	e.refundHistoryBudget(100, false)
+	if !e.reserveHistoryBudget(100, false) || e.reserveHistoryBudget(100, false) {
+		t.Fatal("failed write did not refund exactly one reservation")
+	}
+	if !e.reserveHistoryBudget(101, false) {
+		t.Fatal("new second did not reset budget")
+	}
+	e.refundHistoryBudget(100, false)
+	for i := 0; i < 16; i++ {
+		if !e.reserveHistoryBudget(101, false) {
+			t.Fatal("old reservation changed new window")
+		}
+	}
+	if e.reserveHistoryBudget(101, false) {
+		t.Fatal("late refund exceeded new window budget")
+	}
+	if e.reserveHistoryBudget(100, false) {
+		t.Fatal("delayed admission reset a newer budget window")
+	}
+}
+
+func TestHistoryPeriodicBudgetLeavesCapacityForChanges(t *testing.T) {
+	e := &Entity{}
+	e.cfg.HistoryBudget = 200
+	for i := 0; i < 100; i++ {
+		if !e.reserveHistoryBudget(100, true) {
+			t.Fatal("periodic capacity missing")
+		}
+	}
+	if e.reserveHistoryBudget(100, true) {
+		t.Fatal("periodic cap exceeded")
+	}
+	if !e.reserveHistoryBudget(100, false) {
+		t.Fatal("state change lost reserved capacity")
+	}
+}
