{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "title": "MeshOps - 状态事件链路",
  "uid": "meshops-entity-pipeline",
  "tags": ["meshops", "entity", "kafka"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "接入速率 (events/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(meshops_ingest_events_received_total[1m])",
          "legendFormat": "接收",
          "refId": "A"
        },
        {
          "expr": "rate(meshops_ingest_events_accepted_total[1m])",
          "legendFormat": "受理",
          "refId": "B"
        },
        {
          "expr": "rate(meshops_ingest_events_rejected_total[1m])",
          "legendFormat": "拒绝",
          "refId": "C"
        }
      ]
    },
    {
      "id": 2,
      "title": "受理延迟 P99 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(meshops_ingest_kafka_produce_duration_ms_bucket[1m]))",
          "legendFormat": "P99",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(meshops_ingest_kafka_produce_duration_ms_bucket[1m]))",
          "legendFormat": "P95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "meshops_entity_projector_lag",
          "legendFormat": "投影器 Lag",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 10000 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "投影延迟 & 版本冲突",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(meshops_entity_projection_duration_ms_bucket[1m]))",
          "legendFormat": "投影延迟 P99",
          "refId": "A"
        },
        {
          "expr": "rate(meshops_entity_version_conflicts_total[1m])",
          "legendFormat": "版本冲突/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "实时订阅",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "meshops_entity_subscribers_active",
          "legendFormat": "活跃订阅者",
          "refId": "A"
        },
        {
          "expr": "meshops_entity_subscriber_queue_depth",
          "legendFormat": "队列深度",
          "refId": "B"
        },
        {
          "expr": "rate(meshops_entity_subscriber_drops_total[1m])",
          "legendFormat": "慢消费者断开/s",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "title": "边缘网关补传积压 (bbolt)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "meshops_gateway_bbolt_pending_count",
          "legendFormat": "待发条数",
          "refId": "A"
        },
        {
          "expr": "meshops_gateway_bbolt_oldest_age_seconds",
          "legendFormat": "最老事件年龄(s)",
          "refId": "B"
        }
      ]
    }
  ]
}
